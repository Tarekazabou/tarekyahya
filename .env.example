# Supabase Configuration
# Copy this file to .env and fill in your actual values for production deployment

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous API key (public - safe to expose in frontend)
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (NEVER expose this in frontend)
# This should only be used in backend/server-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment name
NODE_ENV=development
